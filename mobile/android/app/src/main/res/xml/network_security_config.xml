<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Android no admite rangos de IP en domain-config, así que HTTP se permite a nivel SO
       para que el backend de laboratorio funcione con cualquier IP de PC sin recompilar.
       La restricción real está en la app: validateBackend (JS) y uploadFile (Kotlin)
       rechazan HTTP hacia hosts que no sean LAN privada o loopback. -->
  <base-config cleartextTrafficPermitted="true" />
</network-security-config>
